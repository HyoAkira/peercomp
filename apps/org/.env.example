# Local development example for apps/org.
#
# Copy this file to apps/org/.env and replace every <placeholder> with your own
# local values. apps/org reads its environment with dotenv from its own working
# directory (see the dotenv.config() call at the top of apps/org/src/main.ts).
#
# These are not real credentials. Never commit apps/org/.env.

# The username and password must match MONGO_INITDB_ROOT_USERNAME and
# MONGO_INITDB_ROOT_PASSWORD in apps/backbone/docker-compose.yaml.
MONGODB_URI=mongodb://<mongo-root-username>:<mongo-root-password>@localhost:27017/peercomp?authSource=admin

# The variable is JWTSECRET, with no underscore between JWT and SECRET.
# Use a long, random string. See apps/org/src/middlewares/auth/index.ts
# and apps/org/src/services/user.service.ts.
JWTSECRET=<a-long-random-string>
