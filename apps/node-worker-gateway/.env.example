# Local development example for apps/node-worker-gateway.
#
# Copy this file to apps/node-worker-gateway/.env and replace every <placeholder>
# with your own local values. The gateway reads its environment with dotenv from
# its own working directory (see dotenv.config() in apps/node-worker-gateway/main.ts).
#
# apps/node-worker-gateway/main.ts falls back to a placeholder MongoDB URI when
# MONGODB_URI is unset, so set a real local URI here.
#
# These are not real credentials. Never commit the .env file.

# The username and password must match MONGO_INITDB_ROOT_USERNAME and
# MONGO_INITDB_ROOT_PASSWORD in apps/backbone/docker-compose.yaml.
MONGODB_URI=mongodb://<mongo-root-username>:<mongo-root-password>@localhost:27017/peercomp?authSource=admin
